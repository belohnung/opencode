{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#1a0a14",
    "surface": "#2a1024",
    "overlay": "#3d1a35",
    "foreground": "#f5e6f0",
    "muted": "#9e7a93",
    "hotpink": "#ff69b4",
    "magenta": "#ff2d95",
    "softpink": "#ffb6d9",
    "lavender": "#c8a2f0",
    "cyan": "#7fdbca",
    "mint": "#a0f0d0",
    "peach": "#ffb088",
    "lilac": "#d4a0ff",
    "red": "#ff5c8a",
    "yellow": "#ffe066",
    "white": "#fff0f5"
  },
  "theme": {
    "primary": { "dark": "hotpink", "light": "magenta" },
    "secondary": { "dark": "lavender", "light": "#9b59b6" },
    "accent": { "dark": "cyan", "light": "#2ecc71" },
    "error": { "dark": "red", "light": "#e74c3c" },
    "warning": { "dark": "yellow", "light": "#f39c12" },
