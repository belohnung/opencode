    "markdownListItem": { "dark": "hotpink", "light": "magenta" },
    "markdownListEnumeration": { "dark": "lilac", "light": "#8e44ad" },
    "markdownImage": { "dark": "cyan", "light": "#2ecc71" },
    "markdownImageText": { "dark": "softpink", "light": "#d63384" },
