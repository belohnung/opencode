    "markdownHeading": { "dark": "hotpink", "light": "magenta" },
    "markdownLink": { "dark": "cyan", "light": "#2ecc71" },
    "markdownLinkText": { "dark": "softpink", "light": "#d63384" },
    "markdownCode": { "dark": "lavender", "light": "#9b59b6" },
    "markdownBlockQuote": { "dark": "muted", "light": "#8a6580" },
    "markdownEmph": { "dark": "peach", "light": "#e67e22" },
    "markdownStrong": { "dark": "magenta", "light": "#c2185b" },
