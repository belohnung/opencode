    "borderActive": { "dark": "hotpink", "light": "magenta" },
    "borderSubtle": { "dark": "#120610", "light": "#f8d0e2" },
    "diffAdded": { "dark": "mint", "light": "#27ae60" },
    "diffRemoved": { "dark": "red", "light": "#e74c3c" },
    "diffContext": { "dark": "muted", "light": "#8a6580" },
    "diffHunkHeader": { "dark": "muted", "light": "#8a6580" },
    "diffHighlightAdded": { "dark": "mint", "light": "#27ae60" },
    "diffHighlightRemoved": { "dark": "red", "light": "#e74c3c" },
